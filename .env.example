# Copy to .env (gitignored). Do not commit real keys.
# Place .env at repo root (Terrarium/.env). Vite and docker compose read it there.

# Local infra (host) — avoids clashing with other stacks on 5432/6379
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=terrarium
POSTGRES_PASSWORD=terrarium
POSTGRES_DB=terrarium
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# Corporate TLS (Zscaler etc.) — export your org root CA to infra/certs/zscaler-root.pem
# Docker compose mounts it at /etc/terrarium/certs/zscaler-root.pem
TERRARIUM_SSL_CA_FILE=/etc/terrarium/certs/zscaler-root.pem

# Intent — cheap/fast classifier
GEMINI_API_KEY=
TERRARIUM_MODEL_INTENT=gemini-3.5-flash-lite

# Architecture + application codegen — AWS Bedrock (Claude). Never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
BEDROCK_MODEL=anthropic.claude-sonnet-4-6
# Optional: full inference profile ID/ARN when on-demand model IDs fail (common in eu-central-1)
# BEDROCK_INFERENCE_PROFILE=eu.anthropic.claude-sonnet-4-6

# Codegen fallback when Bedrock fails (same order as plan: Bedrock → Gemini → optional NVIDIA)
TERRARIUM_MODEL_CODEGEN=gemini-3.8-flash
# BEDROCK_CODEGEN_READ_TIMEOUT_S=300
# BEDROCK_PLAN_READ_TIMEOUT_S=90

# NVIDIA is opt-in (a key in .env alone does not override Bedrock/Gemini)
# NVIDIA_API_KEY=
# TERRARIUM_ENABLE_NVIDIA=1
# TERRARIUM_NVIDIA_PLAN_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
# TERRARIUM_NVIDIA_CODEGEN_MODEL=mistralai/codestral-22b-instruct-v0.1

TERRARIUM_AGENTS=live
# port = each generated app on its own 127.0.0.1 host port (isolated origin)
# path = same-origin /preview/{slug}/ (shares parent localStorage)
# host = http://{slug}.127.0.0.1.nip.io
TERRARIUM_PREVIEW_MODE=port

# GitHub OAuth App — Homepage http://localhost:5173
# Authorization callback URL http://127.0.0.1:3010/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT=http://127.0.0.1:3010/github/callback
GITHUB_UI_ORIGIN=http://localhost:5173

# Phase 7 — Trust gate, relay, worker
TERRARIUM_VULN_DB_VERSION=
TERRARIUM_TRUST_OFFLINE=1
TERRARIUM_SCAN_USE_DOCKER=
TERRARIUM_ATTACKER_IMAGE=mcr.microsoft.com/playwright:v1.49.1-noble
RELAY_URL=http://127.0.0.1:3010
WORKER_TOKENS=
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
WHATSAPP_PROVIDER=twilio
WHATSAPP_TEMPLATE_DIGEST=
DIGEST_WHATSAPP_ADDRESS=
RELAY_SKIP_SIGNATURE=
PREVIEW_HMAC_SECRET=
