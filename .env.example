# Copy to .env (gitignored). Do not commit real keys.

# Intent — cheap/fast classifier
GEMINI_API_KEY=
TERRARIUM_MODEL_INTENT=gemini-3.5-flash-lite

# Architecture + application codegen — AWS Bedrock (Claude). Never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
BEDROCK_MODEL=anthropic.claude-sonnet-4-6

# Fallbacks if Bedrock is unset
NVIDIA_API_KEY=
TERRARIUM_NVIDIA_PLAN_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
TERRARIUM_NVIDIA_CODEGEN_MODEL=mistralai/codestral-22b-instruct-v0.1
TERRARIUM_MODEL_PLAN=nvidia/llama-3.1-nemotron-ultra-253b-v1
TERRARIUM_MODEL_CODEGEN=mistralai/codestral-22b-instruct-v0.1

TERRARIUM_AGENTS=live
