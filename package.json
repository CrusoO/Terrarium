{
  "name": "terrarium",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "postinstall": "turbo run build --filter=@terrarium/contracts",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@terrarium/web",
    "dev:api": "uv run uvicorn terrarium_api.main:app --reload --host 0.0.0.0 --port 3001",
    "dev:worker": "uv run arq terrarium_api.worker.WorkerSettings",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "stories:generate": "node scripts/generate-stories.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.8",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
